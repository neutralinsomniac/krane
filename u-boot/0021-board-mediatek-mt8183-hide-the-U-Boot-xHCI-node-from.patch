From 9933df093ba0366c8c55f4bfbfb7510a07008384 Mon Sep 17 00:00:00 2001
From: Valentin Haudiquet <valentin.haudiquet@canonical.com>
Date: Mon, 14 Sep 2026 00:51:09 +0200
Subject: [PATCH 21/21] board: mediatek: mt8183: hide the U-Boot xHCI node from
 the booted kernel

The krane DT carries two views of the single SSUSB block: the U-Boot
xHCI host node (usb@11200000, "mediatek,mt8183-xhci", described for
U-Boot's xhci-mtk driver) and the upstream mtu3 node (usb@11201000)
that Linux binds.  Both claim the shared IPPC register block at
0x11203e00, so when the kernel sees both, its drivers race for
request_mem_region() and the loser takes its USB bus down -- per boot.

DM bound this blob's devices at init and never re-reads it, and the
blob is what bootefi hands the kernel as the EFI device-tree, so
disabling the U-Boot-only node right before the command line (the
EVT_LAST_STAGE_INIT spy) gives Linux the mtu3 view (mac + ippc,
dr_mode = "host") alone.  U-Boot keeps using its xHCI node as before.
---
 board/mediatek/mt8183/mt8183.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/board/mediatek/mt8183/mt8183.c b/board/mediatek/mt8183/mt8183.c
index 82210cf8a56..4b65e115487 100644
--- a/board/mediatek/mt8183/mt8183.c
+++ b/board/mediatek/mt8183/mt8183.c
@@ -4,6 +4,8 @@
  * Author: Fabien Parent <fparent@baylibre.com>
  */
 #include <dm.h>
+#include <event.h>
+#include <fdt_support.h>
 #include <linux/sizes.h>
 #include <net.h>
 
@@ -40,3 +42,32 @@ int board_init(void)
 
 	return 0;
 }
+
+/*
+ * The krane DT carries two views of the single SSUSB block: the U-Boot
+ * xHCI host node (usb@11200000, "mediatek,mt8183-xhci", described for
+ * U-Boot's xhci-mtk driver) and the upstream mtu3 node (usb@11201000)
+ * that Linux binds.  Both claim the shared IPPC register block at
+ * 0x11203e00, so when the kernel sees both, its drivers race for
+ * request_mem_region() and the loser takes its USB bus down -- per
+ * boot.
+ *
+ * DM bound this blob's devices at init and never re-reads it, and the
+ * blob is what bootefi hands the kernel as the EFI device-tree, so
+ * disabling the U-Boot-only node right before the command line gives
+ * Linux the mtu3 view (mac + ippc, dr_mode = "host") alone.
+ */
+static int krane_last_stage_init(void)
+{
+	int off;
+
+	off = fdt_node_offset_by_compatible(gd->fdt_blob, -1,
+					    "mediatek,mt8183-xhci");
+	if (off < 0)
+		return 0;
+
+	fdt_setprop_string(gd->fdt_blob, off, "status", "disabled");
+
+	return 0;
+}
+EVENT_SPY_SIMPLE(EVT_LAST_STAGE_INIT, krane_last_stage_init);
-- 
